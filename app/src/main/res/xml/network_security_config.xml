<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext for local/LAN Ollama + MCP. Public AI hosts are still forced
     HTTPS by NetworkPolicy.enforceHttpsOrThrow. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
