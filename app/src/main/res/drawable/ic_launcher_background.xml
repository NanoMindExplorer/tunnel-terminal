<?xml version="1.0" encoding="utf-8"?>
<!--
    Tunnel Terminal - Launcher Icon Background
    Design: Deep gradient from purple to black, representing "tunnel depth" + tech vibe.
    Safe zone is center 72x72 of 108x108 canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base dark purple fill -->
    <path
        android:fillColor="#0D001A"
        android:pathData="M0,0h108v108h-108z"/>

    <!-- Diagonal gradient overlay (top-left purple to bottom-right black) -->
    <path
        android:fillColor="#1A0033"
        android:pathData="M0,0L108,108L0,108z"/>

    <!-- Tunnel rings - 3 concentric arcs in top-right corner suggesting "tunnel" perspective -->
    <path
        android:fillColor="#00FF8808"
        android:pathData="M108,0 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0"/>
    <path
        android:fillColor="#00D9FF08"
        android:pathData="M108,0 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0"/>
    <path
        android:fillColor="#6200EE14"
        android:pathData="M108,0 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"/>

    <!-- Subtle grid pattern hint (terminal aesthetic) -->
    <path
        android:strokeColor="#00FF8710"
        android:strokeWidth="0.5"
        android:pathData="M0,27L108,27 M0,54L108,54 M0,81L108,81"/>

</vector>
